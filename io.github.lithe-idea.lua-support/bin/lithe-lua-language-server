#!/bin/sh
# LuaLS logs belong to this host session. Generated library definitions keep
# their existing cache lifecycle and never become diagnostic attachments.
set -eu
package_root=$(cd "$(dirname "$0")/.." && pwd)
log_dir=${1:?Lithe must supply the current session log directory}
case "$log_dir" in
  /*) ;;
  *) exit 64 ;;
esac
shift
state_dir="${XDG_CACHE_HOME:-$HOME/Library/Caches}/io.github.lithe-idea.lua-support"
mkdir -p "$state_dir/meta"
exec "$package_root/language-server/bin/lua-language-server" \
  --logpath="$log_dir" \
  --loglevel=warn \
  --metapath="$state_dir/meta" \
  "$@"
